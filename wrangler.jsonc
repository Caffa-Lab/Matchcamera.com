{
  "name": "matchcamera-com",
  "compatibility_date": "2026-08-27",
  "main": "./worker/index.js",
  "analytics_engine_datasets": [
    { "binding": "USAGE_ANALYTICS", "dataset": "matchcamera_usage_v1" }
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "GITHUB_REPO_OWNER": "Caffa-Lab",
    "GITHUB_REPO_NAME": "Matchcamera.com",
    "GITHUB_REPO_BRANCH": "main"
  },
  "secrets": {
    "required": ["GITHUB_ADMIN_TOKEN", "CF_ACCESS_TEAM_DOMAIN", "CF_ACCESS_AUD"]
  }
}
